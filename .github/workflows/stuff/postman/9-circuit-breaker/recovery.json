	"event": [
		{
			"listen": "prerequest",
			"script": {
				"exec": [
					"// Сервисы поднимаются на случайных портах (server.port: 0),",
					"// поэтому реальный порт каждого сервиса берём из Eureka.",
					"const eurekaHost = \u0027http://localhost:8761\u0027;",
					"const appNames = [\u0027product-service\u0027, \u0027order-service\u0027, \u0027inventory-service\u0027];",
					"const unresolvedPort = \u002712345\u0027;",
					"",
					"appNames.forEach((appName) =\u003e {",
					"    if (String(pm.collectionVariables.get(appName + \u0027-port\u0027)) !== unresolvedPort) {",
					"        return;",
					"    }",
					"",
					"    pm.sendRequest({",
					"        url: eurekaHost + \u0027/eureka/v2/apps/\u0027 + appName,",
					"        method: \u0027GET\u0027,",
					"        header: { \u0027Accept\u0027: \u0027application/json\u0027 }",
					"    }, function (err, res) {",
					"        if (err) {",
					"            console.error(\u0027Ошибка запроса к Eureka: \u0027, err);",
					"            return;",
					"        }",
					"",
					"        if (res.code !== 200) {",
					"            console.error(\u0027Не удалось получить данные из Eureka для \u0027 + appName + \u0027. Статус: \u0027, res.code);",
					"            return;",
					"        }",
					"",
					"        const jsonData = res.json();",
					"        const raw = jsonData.application ? jsonData.application.instance : null;",
					"        const instances = Array.isArray(raw) ? raw : (raw ? [raw] : []);",
					"",
					"        // Во время тестов отказоустойчивости сервисы гасят и поднимают заново,",
					"        // поэтому берём последний живой инстанс, а не первый попавшийся.",
					"        const alive = instances.filter(item =\u003e item \u0026\u0026 item.status === \u0027UP\u0027);",
					"        const instance = alive.length \u003e 0 ? alive[alive.length - 1] : null;",
					"",
					"        if (!instance) {",
					"            console.error(\u0027Живой инстанс сервиса \u0027 + appName + \u0027 не зарегистрирован в Eureka.\u0027);",
					"            return;",
					"        }",
					"",
					"        pm.collectionVariables.set(appName + \u0027-port\u0027, instance.port[\u0027$\u0027]);",
					"    });",
					"});",
					"",
					"",
					"// Подставляет тело запроса. Объявляется без const/let, чтобы быть доступным",
					"// в pre-request скриптах отдельных запросов. Объект pm передаётся аргументом:",
					"// у каждого скрипта свой экземпляр pm, и правки чужого экземпляра будут потеряны.",
					"setBody = function (postman, body) {",
					"    postman.request.body.update({",
					"        mode: \u0027raw\u0027,",
					"        raw: JSON.stringify(body),",
					"        options: { raw: { language: \u0027json\u0027 } }",
					"    });",
					"};",
					"",
					"",
					"API = class {",
					"    constructor(postman, verbose = false) {",
					"        this.pm = postman;",
					"        this._verbose = verbose;",
					"    }",
					"",
					"    async createCategory(category, verbose = null) {",
					"        return this.post(\u0027/api/categories\u0027, category, \u0027Ошибка при создании категории: \u0027, verbose);",
					"    }",
					"",
					"    async getCategories(verbose = null) {",
					"        return this.get(\u0027/api/categories\u0027, \u0027Ошибка при получении списка категорий: \u0027, verbose);",
					"    }",
					"",
					"    async createProduct(product, verbose = null) {",
					"        return this.post(\u0027/api/products\u0027, product, \u0027Ошибка при создании товара: \u0027, verbose);",
					"    }",
					"",
					"    async updateProduct(productId, patch, verbose = null) {",
					"        return this.patch(\u0027/api/products/\u0027 + productId, patch, \u0027Ошибка при обновлении товара: \u0027, verbose);",
					"    }",
					"",
					"    async getProduct(productId, verbose = null) {",
					"        return this.get(\u0027/api/products/\u0027 + productId, \u0027Ошибка при получении товара: \u0027, verbose);",
					"    }",
					"",
					"    async createInventory(item, verbose = null) {",
					"        return this.post(\u0027/api/inventory\u0027, item, \u0027Ошибка при создании записи об остатках: \u0027, verbose);",
					"    }",
					"",
					"    async updateInventory(item, verbose = null) {",
					"        return this.put(\u0027/api/inventory\u0027, item, \u0027Ошибка при обновлении остатков: \u0027, verbose);",
					"    }",
					"",
					"    async getInventory(productId, verbose = null) {",
					"        return this.get(\u0027/api/inventory/\u0027 + productId, \u0027Ошибка при получении остатков: \u0027, verbose);",
					"    }",
					"",
					"    async reserveStock(request, verbose = null) {",
					"        return this.post(\u0027/api/inventory/reserve\u0027, request, \u0027Ошибка при резервировании товара: \u0027, verbose);",
					"    }",
					"",
					"    async releaseStock(request, verbose = null) {",
					"        return this.post(\u0027/api/inventory/release\u0027, request, \u0027Ошибка при снятии резерва товара: \u0027, verbose);",
					"    }",
					"",
					"    async deactivateProduct(productId, verbose = null) {",
					"        return this.patch(\u0027/api/products/\u0027 + productId, { active: false },",
					"            \u0027Ошибка при снятии товара с продажи: \u0027, verbose);",
					"    }",
					"",
					"    async createOrder(order, verbose = null) {",
					"        return this.post(\u0027/api/orders\u0027, order, \u0027Ошибка при создании заказа: \u0027, verbose);",
					"    }",
					"",
					"    async getOrder(orderId, verbose = null) {",
					"        return this.get(\u0027/api/orders/\u0027 + orderId, \u0027Ошибка при получении заказа: \u0027, verbose);",
					"    }",
					"",
					"    async post(path, body, errorText = \u0027Ошибка при выполнении post-запроса: \u0027, verbose = null) {",
					"        return this.sendRequest(\u0027POST\u0027, path, body, errorText, verbose);",
					"    }",
					"",
					"    async put(path, body, errorText = \u0027Ошибка при выполнении put-запроса: \u0027, verbose = null) {",
					"        return this.sendRequest(\u0027PUT\u0027, path, body, errorText, verbose);",
					"    }",
					"",
					"    async patch(path, body, errorText = \u0027Ошибка при выполнении patch-запроса: \u0027, verbose = null) {",
					"        return this.sendRequest(\u0027PATCH\u0027, path, body, errorText, verbose);",
					"    }",
					"",
					"    async get(path, errorText = \u0027Ошибка при выполнении get-запроса: \u0027, verbose = null) {",
					"        return this.sendRequest(\u0027GET\u0027, path, null, errorText, verbose);",
					"    }",
					"",
					"    baseUrlFor(path) {",
					"        const resource = path.split(\u0027?\u0027)[0].split(\u0027/\u0027)[2];",
					"        const baseUrl = pm.collectionVariables.get(\u0027baseUrl\u0027);",
					"",
					"        switch (resource) {",
					"            case \u0027products\u0027:",
					"            case \u0027categories\u0027:",
					"                return baseUrl + pm.collectionVariables.get(\u0027product-service-port\u0027);",
					"            case \u0027orders\u0027:",
					"                return baseUrl + pm.collectionVariables.get(\u0027order-service-port\u0027);",
					"            case \u0027inventory\u0027:",
					"                return baseUrl + pm.collectionVariables.get(\u0027inventory-service-port\u0027);",
					"            default:",
					"                throw new Error(\u0027Неизвестный ресурс в пути запроса: \u0027 + path);",
					"        }",
					"    }",
					"",
					"    async sendRequest(method, path, body = null, errorText = \u0027Ошибка при выполнении запроса: \u0027, verbose = null) {",
					"        return new Promise((resolve, reject) =\u003e {",
					"            verbose = verbose == null ? this._verbose : verbose;",
					"",
					"            const request = {",
					"                url: this.baseUrlFor(path) + path,",
					"                method: method,",
					"                body: body == null ? \u0027\u0027 : JSON.stringify(body),",
					"                header: { \u0027Content-Type\u0027: \u0027application/json\u0027 }",
					"            };",
					"",
					"            if (verbose) {",
					"                console.log(\u0027Отправляю запрос: \u0027, request);",
					"            }",
					"",
					"            try {",
					"                this.pm.sendRequest(request, (error, response) =\u003e {",
					"                    if (error || (response.code \u003e= 400 \u0026\u0026 response.code \u003c= 599)) {",
					"                        const err = error ? error : JSON.stringify(response.json());",
					"                        console.error(\u0027При выполнении запроса к серверу возникла ошибка.\u0027, err,",
					"                            \u0027Для отладки проблемы повторите такой же запрос к вашей программе \u0027 +",
					"                            \u0027на локальном компьютере. Данные запроса: \u0027, JSON.stringify(request));",
					"",
					"                        reject(new Error(errorText + err));",
					"                        return;",
					"                    }",
					"",
					"                    if (verbose) {",
					"                        console.log(\u0027Результат обработки запроса: код состояния - \u0027, response.code);",
					"                    }",
					"",
					"                    if (response.stream.length === 0) {",
					"                        resolve(\u0027\u0027);",
					"                    } else {",
					"                        resolve(response.json());",
					"                    }",
					"                });",
					"            } catch (err) {",
					"                if (verbose) {",
					"                    console.error(errorText, err);",
					"                }",
					"                reject(err);",
					"            }",
					"        });",
					"    }",
					"};",
					"",
					"",
					"RandomUtils = class {",
					"    constructor() {}",
					"",
					"    productNames = [",
					"        \u0027Умная лампа\u0027, \u0027Датчик движения\u0027, \u0027Контроллер освещения\u0027,",
					"        \u0027Термометр\u0027, \u0027Розетка Wi-Fi\u0027, \u0027Светодиодная лента\u0027,",
					"        \u0027Камера наблюдения\u0027, \u0027Умный замок\u0027, \u0027Зарядное устройство\u0027",
					"    ];",
					"",
					"    descriptions = [",
					"        \u0027Высококачественный продукт для умного дома.\u0027,",
					"        \u0027Легко интегрируется с другими устройствами.\u0027,",
					"        \u0027Обеспечивает надёжную работу 24/7.\u0027,",
					"        \u0027Простой в установке и использовании.\u0027,",
					"        \u0027Современный дизайн и высокая производительность.\u0027",
					"    ];",
					"",
					"    categoryNames = [",
					"        \u0027Освещение\u0027, \u0027Безопасность\u0027, \u0027Климат\u0027,",
					"        \u0027Управление\u0027, \u0027Бытовая техника\u0027, \u0027Энергоснабжение\u0027",
					"    ];",
					"",
					"    customerNames = [",
					"        \u0027Иван Петров\u0027, \u0027Мария Кузнецова\u0027, \u0027Алексей Смирнов\u0027, \u0027Ольга Соколова\u0027,",
					"        \u0027Дмитрий Попов\u0027, \u0027Татьяна Козлова\u0027, \u0027Николай Морозов\u0027, \u0027Анна Волкова\u0027",
					"    ];",
					"",
					"    getItem(list) {",
					"        return list[Math.floor(Math.random() * list.length)];",
					"    }",
					"",
					"    getWord(length = 1) {",
					"        const characters = \u0027ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789\u0027;",
					"        let result = \u0027\u0027;",
					"        let counter = 0;",
					"        while (counter \u003c length) {",
					"            result += characters.charAt(Math.floor(Math.random() * characters.length));",
					"            counter += 1;",
					"        }",
					"        return result;",
					"    }",
					"",
					"    getPrice(min = 7, max = 1000) {",
					"        return Number((Math.random() * (max - min) + min).toFixed(2));",
					"    }",
					"",
					"    getQuantity(min = 1, max = 5) {",
					"        return Math.floor(Math.random() * (max - min + 1)) + min;",
					"    }",
					"",
					"    // Идентификатор, которого заведомо нет в базе: начальные данные занимают id 1..12.",
					"    getUnknownId() {",
					"        return Math.floor(Math.random() * 900000000) + 100000000;",
					"    }",
					"",
					"    // inventory-service не проверяет товар в product-service, поэтому для складских",
					"    // тестов productId можно генерировать независимо. Для заказов так делать нельзя:",
					"    // order-service ходит за товаром в product-service через Feign.",
					"    getExternalProductId() {",
					"        return Math.floor(Math.random() * 900000000) + 100000000;",
					"    }",
					"",
					"    getEmail() {",
					"        return this.getWord(10).toLowerCase() + \u0027@smart-home-test.ru\u0027;",
					"    }",
					"",
					"    getCategory() {",
					"        return {",
					"            name: this.getItem(this.categoryNames) + \u0027 \u0027 + this.getWord(8),",
					"            description: this.getItem(this.descriptions)",
					"        };",
					"    }",
					"",
					"    getProduct(categoryId = null) {",
					"        const product = {",
					"            name: this.getItem(this.productNames) + \u0027 \u0027 + this.getWord(8),",
					"            description: this.getItem(this.descriptions),",
					"            price: this.getPrice(),",
					"            imageUrl: \u0027https://cdn.smart-home.test/\u0027 + this.getWord(8) + \u0027.png\u0027",
					"        };",
					"",
					"        if (categoryId !== null) {",
					"            product.categoryId = categoryId;",
					"        }",
					"",
					"        return product;",
					"    }",
					"",
					"    getInventoryItem(productId = null, quantity = null) {",
					"        return {",
					"            productId: productId === null ? this.getExternalProductId() : productId,",
					"            quantity: quantity === null ? this.getQuantity(50, 200) : quantity",
					"        };",
					"    }",
					"",
					"    // Позиция заказа теперь содержит только идентификатор товара и количество:",
					"    // название и цену order-service берёт из product-service.",
					"    getOrderItem(productId = null, quantity = null) {",
					"        return {",
					"            productId: productId === null ? this.getExternalProductId() : productId,",
					"            quantity: quantity === null ? this.getQuantity(1, 5) : quantity",
					"        };",
					"    }",
					"",
					"    getOrder(email = null, items = null) {",
					"        return {",
					"            customerName: this.getItem(this.customerNames),",
					"            customerEmail: email === null ? this.getEmail() : email,",
					"            items: items === null ? [this.getOrderItem()] : items",
					"        };",
					"    }",
					"};",
					"",
					"// Готовит товар, доступный для заказа: категория -\u003e товар -\u003e запись об остатках.",
					"// Объявляется без const/let, чтобы быть доступным в скриптах отдельных запросов.",
					"prepareCatalogItem = async function (api, rnd, stock = 100) {",
					"    const category = await api.createCategory(rnd.getCategory());",
					"    const product = await api.createProduct(rnd.getProduct(category.id));",
					"    const inventory = await api.createInventory({ productId: product.id, quantity: stock });",
					"",
					"    return { category: category, product: product, inventory: inventory };",
					"};",
					"",
					"",
					"// Создаёт заказ, все позиции которого заведены в product-service и inventory-service.",
					"// Возвращает { order, products, request }.",
					"createOrderWithRealProducts = async function (api, rnd, email = null, itemsCount = 2, stock = 100) {",
					"    const products = [];",
					"    const items = [];",
					"",
					"    for (let i = 0; i \u003c itemsCount; i += 1) {",
					"        const prepared = await prepareCatalogItem(api, rnd, stock);",
					"        products.push(prepared.product);",
					"        items.push(rnd.getOrderItem(prepared.product.id, rnd.getQuantity(1, 5)));",
					"    }",
					"",
					"    const request = rnd.getOrder(email, items);",
					"    const order = await api.createOrder(request);",
					"",
					"    return { order: order, products: products, request: request };",
					"};",
					"",
					"sleep = function (ms) {",
					"    return new Promise(resolve =\u003e setTimeout(resolve, ms));",
					"};",
					"",
					"",
					"// Готовит только товар в каталоге: запись об остатках создать нельзя,",
					"// когда inventory-service намеренно погашен.",
					"prepareProduct = async function (api, rnd) {",
					"    const category = await api.createCategory(rnd.getCategory());",
					"    return api.createProduct(rnd.getProduct(category.id));",
					"};",
					"",
					"",
					"// Пытается оформить заказ до тех пор, пока он не будет подтверждён.",
					"// Нужно после восстановления сервиса: circuit breaker какое-то время остаётся",
					"// разомкнутым, а клиенты не сразу узнают об инстансе из Eureka.",
					"waitForConfirmedOrders = async function (api, rnd, attempts = 6, delayMs = 8000) {",
					"    for (let attempt = 1; attempt \u003c= attempts; attempt += 1) {",
					"        try {",
					"            const prepared = await prepareCatalogItem(api, rnd, 50);",
					"            const order = await api.createOrder(rnd.getOrder(null, [rnd.getOrderItem(prepared.product.id, 1)]));",
					"",
					"            if (order.status === \u0027CONFIRMED\u0027) {",
					"                console.log(\u0027Стенд восстановился с попытки \u0027 + attempt);",
					"                return true;",
					"            }",
					"",
					"            console.log(\u0027Попытка \u0027 + attempt + \u0027: заказ получил статус \u0027 + order.status + \u0027, ждём...\u0027);",
					"        } catch (e) {",
					"            console.log(\u0027Попытка \u0027 + attempt + \u0027 завершилась ошибкой: \u0027 + e);",
					"        }",
					"",
					"        await sleep(delayMs);",
					"    }",
					"",
					"    return false;",
					"};"
				],
				"type": "text/javascript",
				"packages": {
					
				}
			}
		},
