{
	"info": {
		"_postman_id": "e5a1c9d7-8b32-4f16-9e04-2c7d6b8a3f95",
		"name": "(Sprint 21) Circuit Breaker - восстановление inventory-service",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "create Order After Inventory Recovery",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const main = async () =\u003e {",
							"    const api = new API(pm);",
							"    const rnd = new RandomUtils();",
							"",
							"    const recovered = await waitForConfirmedOrders(api, rnd);",
							"    if (!recovered) {",
							"        console.error(\u0027Стенд не восстановился: заказы всё ещё не подтверждаются.\u0027);",
							"    }",
							"",
							"    const stock = 40;",
							"    const quantity = 6;",
							"    const prepared = await prepareCatalogItem(api, rnd, stock);",
							"    const order = rnd.getOrder(null, [rnd.getOrderItem(prepared.product.id, quantity)]);",
							"",
							"    pm.collectionVariables.set(\u0027product\u0027, JSON.stringify(prepared.product));",
							"    pm.collectionVariables.set(\u0027product_id\u0027, prepared.product.id);",
							"    pm.collectionVariables.set(\u0027stock\u0027, stock);",
							"    pm.collectionVariables.set(\u0027ordered_quantity\u0027, quantity);",
							"",
							"    setBody(pm, order);",
							"};",
							"",
							"const interval = setInterval(() =\u003e {}, 1000);",
							"",
							"setTimeout(async () =\u003e {",
							"    try {",
							"        await main();",
							"    } catch (e) {",
							"        console.error(e);",
							"    } finally {",
							"        clearInterval(interval);",
							"    }",
							"}, 100);"
						],
						"type": "text/javascript",
						"packages": {
							
						}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\u0027Код ответа 200 или 201\u0027, function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
							"});",
							"",
							"pm.test(\u0027После восстановления склада заказ снова подтверждается\u0027, function () {",
							"    const responseJson = pm.response.json();",
							"",
							"    pm.expect(responseJson.status,",
							"        \u0027Circuit breaker должен замкнуться, и заказ обязан получить статус CONFIRMED\u0027)",
							"        .to.equal(\u0027CONFIRMED\u0027);",
							"});",
							"",
							"pm.test(\u0027Стоимость заказа снова считается по каталогу\u0027, function () {",
							"    const responseJson = pm.response.json();",
							"    const product = JSON.parse(pm.collectionVariables.get(\u0027product\u0027));",
							"    const quantity = Number(pm.collectionVariables.get(\u0027ordered_quantity\u0027));",
							"",
							"    const item = responseJson.items.find(candidate =\u003e candidate.productId === product.id);",
							"",
							"    pm.expect(item, \u0027Позиция заказа отсутствует\u0027).to.not.be.undefined;",
							"    pm.expect(item.productName, \u0027Поле productName\u0027).to.equal(product.name);",
							"    pm.expect(Number(item.price), \u0027Поле price\u0027).to.be.closeTo(Number(product.price), 0.011);",
							"    pm.expect(Number(responseJson.totalPrice), \u0027Поле totalPrice\u0027)",
							"        .to.be.closeTo(Number(product.price) * quantity, 0.011);",
							"});",
							"",
							"[\u0027product\u0027].forEach(key =\u003e pm.collectionVariables.unset(key));"
						],
						"type": "text/javascript",
						"packages": {
							
						}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "*/*"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "",
					"options": {
						"raw": {
							"headerFamily": "json",
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}{{order-service-port}}/api/orders",
					"host": [
						"{{baseUrl}}{{order-service-port}}"
					],
					"path": [
						"api",
						"orders"
					]
				},
				"description": "После восстановления склада circuit breaker должен замкнуться, а заказы — снова подтверждаться."
			},
			"response": [
				
			]
		},
		{
			"name": "inventory Reserved After Recovery",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\u0027Код ответа 200\u0027, function () {",
							"    pm.expect(pm.response.code).to.equal(200);",
							"});",
							"",
							"pm.test(\u0027Резерв поставлен на восстановленном складе\u0027, function () {",
							"    const responseJson = pm.response.json();",
							"    const stock = Number(pm.collectionVariables.get(\u0027stock\u0027));",
							"    const ordered = Number(pm.collectionVariables.get(\u0027ordered_quantity\u0027));",
							"",
							"    pm.expect(responseJson.quantity, \u0027Общее количество на складе\u0027).to.equal(stock);",
							"    pm.expect(responseJson.reservedQuantity, \u0027Поле reservedQuantity\u0027).to.equal(ordered);",
							"    pm.expect(responseJson.availableQuantity, \u0027Поле availableQuantity\u0027).to.equal(stock - ordered);",
							"});",
							"",
							"[\u0027product_id\u0027, \u0027stock\u0027, \u0027ordered_quantity\u0027].forEach(key =\u003e pm.collectionVariables.unset(key));"
						],
						"type": "text/javascript",
						"packages": {
							
						}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "*/*"
					}
				],
				"url": {
					"raw": "{{baseUrl}}{{inventory-service-port}}/api/inventory/{{product_id}}",
					"host": [
						"{{baseUrl}}{{inventory-service-port}}"
					],
					"path": [
						"api",
						"inventory",
						"{{product_id}}"
					]
				},
				"description": "После восстановления склада резерв должен снова реально ставиться, а не подменяться fallback-ответом."
			},
			"response": [
				
			]
		}
