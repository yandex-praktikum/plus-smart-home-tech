		{
			"name": "order Created Through Gateway",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const main = async () => {",
							"    const api = new API(pm);",
							"    const rnd = new RandomUtils();",
							"",
							"    // Каталог и остатки готовим тоже через gateway: если хотя бы один",
							"    // из маршрутов настроен неверно, подготовка упадёт ещё до заказа.",
							"    const prepared = await prepareCatalogItem(api, rnd, 100);",
							"    const quantity = 3;",
							"    const order = rnd.getOrder(null, [rnd.getOrderItem(prepared.product.id, quantity)]);",
							"",
							"    pm.collectionVariables.set('order', JSON.stringify(order));",
							"    pm.collectionVariables.set('product', JSON.stringify(prepared.product));",
							"    pm.collectionVariables.set('ordered_quantity', quantity);",
							"",
							"    setBody(pm, order);",
							"};",
							"",
							"const interval = setInterval(() => {}, 1000);",
							"",
							"setTimeout(async () => {",
							"    try {",
							"        await main();",
							"    } catch (e) {",
							"        console.error(e);",
							"    } finally {",
							"        clearInterval(interval);",
							"    }",
							"}, 100);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Код ответа 200 или 201', function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
							"});",
							"",
							"pm.test('Заказ подтверждён: все три сервиса доступны через gateway', function () {",
							"    const responseJson = pm.response.json();",
							"",
							"    pm.expect(responseJson.status,",
							"        'Стенд поднят полностью, заказ должен быть подтверждён').to.equal('CONFIRMED');",
							"});",
							"",
							"pm.test('Название и цена товара получены из product-service', function () {",
							"    const responseJson = pm.response.json();",
							"    const product = JSON.parse(pm.collectionVariables.get('product'));",
							"    const quantity = Number(pm.collectionVariables.get('ordered_quantity'));",
							"",
							"    const item = responseJson.items.find(candidate => candidate.productId === product.id);",
							"",
							"    pm.expect(item, 'Позиция с productId=' + product.id + ' отсутствует в заказе').to.not.be.undefined;",
							"    pm.expect(item.productName, 'Название товара должно совпадать с каталогом').to.equal(product.name);",
							"    pm.expect(Number(responseJson.totalPrice), 'Стоимость заказа считается по цене из каталога')",
							"        .to.be.closeTo(Number(product.price) * quantity, 0.011);",
							"});",
							"",
							"['order', 'product', 'ordered_quantity'].forEach(key => pm.collectionVariables.unset(key));"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "*/*"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "",
					"options": {
						"raw": {
							"headerFamily": "json",
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{gatewayUrl}}/api/orders",
					"host": [
						"{{gatewayUrl}}"
					],
					"path": [
						"api",
						"orders"
					]
				},
				"description": "Сквозной сценарий через gateway: каталог, остатки и заказ. Проверяет, что за gateway сервисы по-прежнему находят друг друга через Eureka."
			},
			"response": []
		}
